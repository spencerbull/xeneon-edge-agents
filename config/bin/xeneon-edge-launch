#!/usr/bin/env bash

set -euo pipefail

readonly app_name="XENEON EDGE Command Center"
readonly daemon_unit=xeneon-agentd.service
readonly portal_unit=xeneon-edge-portal.service
launcher_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
readonly agentctl="$launcher_dir/xeneon-agentctl"

notify() {
  local urgency=$1
  local message=$2
  if command -v notify-send >/dev/null 2>&1; then
    notify-send --app-name="$app_name" --icon=xeneon-edge-agents \
      --urgency="$urgency" "$app_name" "$message" || true
  fi
}

case "${1:-}" in
  "")
    verb=start
    success_message="Command center is running."
    ;;
  --restart)
    verb=restart
    success_message="Command center restarted."
    ;;
  *)
    notify critical "Unknown launcher action."
    exit 64
    ;;
esac

if ! systemctl --user "$verb" "$daemon_unit" "$portal_unit"; then
  notify critical "Could not $verb the user services."
  exit 1
fi

# Type=simple units can report active just before the daemon socket is ready.
# Retry only the read-only health probe, never a lifecycle action.
for _ in {1..20}; do
  if systemctl --user is-active --quiet "$daemon_unit" &&
    systemctl --user is-active --quiet "$portal_unit" &&
    "$agentctl" doctor >/dev/null 2>&1; then
    notify normal "$success_message"
    exit 0
  fi
  sleep 0.25
done

notify critical "Services started but did not become healthy."
exit 1
