#!/usr/bin/python3
"""Publish T3-owned metadata outside the read-only hardware daemon sandbox."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import signal
import subprocess

FIELDS = ('thread_id', 'title', 'project_title', 'workspace_root', 'branch',
          'worktree_path', 'provider', 'status', 'settled', 'snoozed',
          'pending_input', 'background_work', 'updated_at',
          'latest_run_completed_at', 'last_visited_at')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--t3-bin', default='t3')
    parser.add_argument('--t3-home', type=Path, default=Path(os.environ.get('T3CODE_HOME', str(Path.home()/'.t3'))))
    parser.add_argument('--output', type=Path, default=Path(os.environ['XDG_RUNTIME_DIR'])/'xeneon-edge-agents/t3-status.json')
    args = parser.parse_args()
    os.umask(0o077)
    args.output.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    with args.output.with_suffix('.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        process = subprocess.Popen([args.t3_bin, 'thread', 'status', '--json', '--watch', '--base-dir', str(args.t3_home)],
                                   stdin=subprocess.DEVNULL, stdout=subprocess.PIPE)
        stopping = False
        def stop(*_):
            nonlocal stopping
            stopping = True
            if process.poll() is None:
                process.terminate()
        for sig in (signal.SIGTERM, signal.SIGINT):
            signal.signal(sig, stop)
        try:
            while True:
                line = process.stdout.readline(4_194_305)
                if stopping:
                    break
                if not line or len(line) > 4_194_304 or not line.endswith(b'\n'):
                    raise RuntimeError('T3 metadata feed ended or exceeded its frame limit')
                frame = json.loads(line)
                if frame['schema_version'] != 1 or len(frame['threads']) > 64:
                    raise RuntimeError('unsupported T3 metadata feed')
                result = {key: frame[key] for key in ('schema_version', 'environment_id', 'generated_at_ms')}
                result['threads'] = [{key: thread.get(key) for key in FIELDS} for thread in frame['threads']]
                temporary = args.output.with_suffix('.tmp')
                temporary.write_text(json.dumps(result, ensure_ascii=False))
                temporary.chmod(0o600)
                temporary.replace(args.output)
        finally:
            process.terminate()
            try:
                process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                process.kill(); process.wait()
            args.output.unlink(missing_ok=True)
            args.output.with_suffix('.tmp').unlink(missing_ok=True)


if __name__ == '__main__':
    main()
