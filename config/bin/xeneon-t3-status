#!/usr/bin/python3
"""Publish metadata-only T3 fleet and thread status outside the daemon sandbox.

Reads only allowlisted scalar metadata from:
  1. Local read-only T3 Code SQLite projections (never messages, prompts,
     activities, checkpoints, or T3 secrets).
  2. T3 Connect Relay fleet status & aggregate activity endpoints using this
     helper's own OAuth token and ES256 DPoP key stored under
     $XDG_STATE_HOME/xeneon-edge-agents/t3-connect/.
  3. Approved remote T3 environments' /api/orchestration/shell endpoint,
     strictly projecting only allowlisted scalar metadata fields.
"""
import argparse
import base64
from concurrent.futures import ThreadPoolExecutor, as_completed
from datetime import datetime, timezone
import fcntl
import getpass
import hashlib
import json
import os
from pathlib import Path
import platform
import selectors
import shutil
import signal
import socket
import sqlite3
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid

DEFAULT_RELAY_URL = 'https://relay.t3.codes'
DEFAULT_OAUTH_ISSUER = 'https://clerk.t3.codes'
DEFAULT_OAUTH_CLIENT_ID = 'hzxSgY2cH10sDU2r'
DEFAULT_OAUTH_SCOPE = 'openid profile email offline_access'
MAX_FRAME_BYTES = 4_194_304
MAX_DEVICES = 32
MAX_THREADS = 64
MAX_SQLITE_CANDIDATES = 512
WRITE_INTERVAL_SEC = 2.0
ENV_POLL_INTERVAL_SEC = 15.0
ACTIVITY_POLL_INTERVAL_SEC = 5.0
SHELL_POLL_INTERVAL_SEC = 10.0
APPROVAL_BACKOFF_SEC = 300.0
SHELL_FRESH_WINDOW_SEC = 60.0
ACTIVITY_FRESH_WINDOW_SEC = 60.0
ENV_FRESH_WINDOW_SEC = 90.0
HTTP_TIMEOUT_SEC = 8.0

THREAD_FIELDS = (
    'environment_id',
    'device_label',
    'device_local',
    'thread_id',
    'title',
    'project_title',
    'workspace_root',
    'branch',
    'worktree_path',
    'provider',
    'status',
    'settled',
    'snoozed',
    'pending_input',
    'background_work',
    'updated_at',
    'latest_run_completed_at',
    'last_visited_at',
)

