-- Generated by xeneon-edge-agents. hyprmoncfg remains the monitor-layout
-- authority. This module only maps the exact touchscreen and requests a fixed
-- lifecycle reconciliation when the commissioned screen changes.
local touchDevice = "@TOUCH_DEVICE@"
local startReconcileCommand =
  "/usr/bin/systemctl --user start xeneon-edge-reconcile.service"
local restartReconcileCommand =
  "/usr/bin/systemctl --user restart xeneon-edge-reconcile.service"

local function disableTouch()
  -- A touch device bound to a removed output can fall back to the focused
  -- monitor. Disable it synchronously; the reconciler re-enables it only after
  -- the complete EDID, serial/model, and kernel touch identity passes.
  hl.device({
    name = touchDevice,
    enabled = false,
  })
end

local function startReconcile()
  disableTouch()
  hl.exec_cmd(startReconcileCommand)
end

local function restartReconcile()
  disableTouch()
  -- A monitor edge must supersede an in-flight settle pass. `start` can be
  -- coalesced while the oneshot is activating; `restart` queues a fresh
  -- inventory after terminating that stale pass.
  hl.exec_cmd(restartReconcileCommand)
end

hl.on("monitor.added", restartReconcile)
hl.on("monitor.removed", restartReconcile)
startReconcile()
