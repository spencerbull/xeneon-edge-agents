# Agent manager observed at startup: "herdr" or "t3code". The portal's
# Manager control switches between them at runtime and persists the choice
# under $XDG_STATE_HOME/xeneon-edge-agents/agent-backend.toml.
agent_backend = "herdr"
herdr_bin = "herdr"
voxtype_bin = "voxtype"
herdr_refresh_ms = 5000
health_refresh_ms = 1000
voice_refresh_ms = 250
usage_refresh_ms = 30000
micro_refresh_ms = 5000

[screen]
# Production commissioning writes connector, serial, model, and touch_device.
# Their absence is intentional: the simulator-safe default identifies no EDGE.

[t3code]
# T3 Code data directory. Defaults to $T3CODE_HOME, then ~/.t3. Only the
# read-only state projection and server runtime descriptor are read.
# home = "/home/user/.t3"
refresh_ms = 1000

[desktop]
herdr_class = "herdr"
# Production commissioning writes edge_output.
