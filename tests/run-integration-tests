#!/usr/bin/env bash

set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
cd "$repo_root"

command -v luac >/dev/null 2>&1 || {
  printf 'error: luac is required for Hyprland integration tests\n' >&2
  exit 1
}

cargo build --workspace
XENEON_AGENTD_BIN=${XENEON_AGENTD_BIN:-"$repo_root/target/debug/xeneon-agentd"} \
  "$repo_root/tests/install_integration.sh"
python3 "$repo_root/tests/test_herdr_compatibility.py"
